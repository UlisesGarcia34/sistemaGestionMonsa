# Copia este archivo a .env y ajusta los valores

DATABASE_URL="mysql://monsa:monsa@localhost:3306/monsa_gestion"
PORT=4000
NODE_ENV=development

# --- Autenticacion (modules/auth) ---------------------------------------
# Secreto de firma del JWT. Minimo 16 caracteres. En desarrollo, si falta, se
# usa un secreto obvio y el arranque avisa; en produccion el arranque falla.
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
# Vigencia del token (formato de la libreria jsonwebtoken: 30m, 8h, 7d...).
JWT_EXPIRES_IN="8h"

# --- Envio de correo (shared/mailer.ts) ---------------------------------
# Usado por el modulo de reportes para mandar la carta de instrucciones al
# cliente. NO hay credenciales por defecto: mientras estas variables esten
# vacias, el envio falla con un mensaje explicito y nada sale del sistema.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Monsa Global Cargo <no-reply@monsaglobalcargo.com>"
